# SQLite database file
DATABASE_URL="file:./dev.db"
# Organizer API base URL WITHOUT the group_id parameter (taken from the "Открыть GET для DEV" button in the guide)
ORGANIZER_API_URL="https://<organizer-host>/...invoke?api-version=1&sp=...&sv=1.0&sig=..."
# Evaluator implementation: mock (default). Real LLM providers can be added in src/lib/evaluator/
EVALUATOR="mock"
