# SQLite database file
DATABASE_URL="file:./dev.db"

# Organizer API base URL WITHOUT the group_id parameter (taken from the "Открыть GET для DEV" button in the guide)
ORGANIZER_API_URL="https://<organizer-host>/...invoke?api-version=1&sp=...&sv=1.0&sig=..."

# Evaluator engine:
# - "two-stage-ai" : Runs AI #1 (Analyzer) -> AI #2 (Judge & Weigher) via Groq + Gemini
# - "mock"         : Deterministic multilingual heuristic evaluator ($0, instant)
EVALUATOR="two-stage-ai"

# Google Gemini API key (for audio call analysis and fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq API key (for ultra-fast text chat analysis and judging)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
